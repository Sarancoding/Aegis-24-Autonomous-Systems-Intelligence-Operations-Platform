{
  "mcp_servers": {
    "sec_edgar": {
      "url": "https://www.sec.gov/cgi-bin/browse-edgar",
      "description": "SEC EDGAR database for financial filings",
      "auth_type": "none",
      "rate_limit": 10,
      "timeout_seconds": 30
    },
    "github_api": {
      "url": "https://api.github.com",
      "description": "GitHub API for code repository access",
      "auth_type": "bearer_token",
      "rate_limit": 5000,
      "timeout_seconds": 10
    },
    "sentry": {
      "url": "https://sentry.io/api",
      "description": "Sentry error tracking API",
      "auth_type": "bearer_token",
      "rate_limit": 100,
      "timeout_seconds": 15
    },
    "rss_feed": {
      "url": "custom",
      "description": "RSS feed aggregator for news and alerts",
      "auth_type": "none",
      "rate_limit": 60,
      "timeout_seconds": 20
    },
    "postgres_cdc": {
      "url": "localhost:5432",
      "description": "PostgreSQL Change Data Capture",
      "auth_type": "password",
      "rate_limit": 1000,
      "timeout_seconds": 5
    }
  },
  "connection_pool": {
    "max_connections": 50,
    "min_connections": 5,
    "connection_timeout": 30,
    "idle_timeout": 300
  },
  "retry_policy": {
    "max_retries": 3,
    "backoff_factor": 2,
    "retry_on": ["timeout", "connection_error", "rate_limit"]
  }
}
